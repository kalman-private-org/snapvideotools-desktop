<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.shape.Rectangle?>

<HBox fx:id="rootContainer" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kalman03.svt.desktop.controller.TaskItemController"
      spacing="16" alignment="CENTER_LEFT" styleClass="queue-item">

    <!-- Thumbnail -->
    <StackPane fx:id="thumbnailContainer" prefWidth="81" prefHeight="144" minWidth="81" minHeight="144" maxWidth="81" maxHeight="144"
               style="-fx-background-color: linear-gradient(to bottom right, #005c45, #00876a); -fx-background-radius: 12;">
        <ImageView fx:id="thumbnailImageView" fitWidth="81" fitHeight="144" preserveRatio="false" smooth="true"
                   visible="false" managed="false"/>
        <Rectangle fx:id="thumbnailProgressRing" fill="transparent" stroke="#5B7CFA" strokeWidth="4"
                   arcWidth="24" arcHeight="24" visible="false" managed="false" mouseTransparent="true"/>
        <Label fx:id="thumbnailProgressLabel" text="0%" visible="false" managed="false"
               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-color: rgba(0,0,0,0.35); -fx-background-radius: 10; -fx-padding: 2 6;"
               mouseTransparent="true"/>
        <Label fx:id="thumbnailPlaceholderLabel" text="No Thumbnail" wrapText="true"
               style="-fx-text-fill: rgba(255,255,255,0.92); -fx-font-weight: bold; -fx-font-size: 12px;"
               alignment="CENTER"/>
    </StackPane>

    <!-- Info -->
    <VBox fx:id="infoBox" spacing="6">
        <!-- Title with media type icon and deleted tag -->
        <HBox fx:id="titleBox" spacing="6" alignment="CENTER_LEFT">
            <FontIcon fx:id="mediaTypeIcon" iconLiteral="mdmz-videocam" iconSize="16" iconColor="#49454F"/>
            <Label fx:id="deletedTagLabel" text="" visible="false" managed="false"
                   style="-fx-background-color: #9CA3AF; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 2 6; -fx-background-radius: 4;"/>
            <Label fx:id="titleLabel" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
        </HBox>
        <!-- Platform and file info -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="platformLabel" style="-fx-text-fill: #49454F; -fx-font-size: 13px;"/>
            <Label fx:id="fileSizeLabel" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" visible="false" managed="false"/>
            <Label fx:id="downloadTimeLabel" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" visible="false" managed="false"/>
        </HBox>
        
        <Label fx:id="statusLabel" visible="false" managed="false"/>
    </VBox>

    <!-- Spacer -->
    <Region HBox.hgrow="ALWAYS"/>

    <!-- Actions -->
    <HBox fx:id="actionsBox" spacing="8">
        <Button fx:id="retryBtn" styleClass="button-secondary" visible="false" managed="false" onAction="#handleRetry">
            <graphic>
                <FontIcon iconLiteral="mdmz-refresh" iconSize="18" iconColor="#49454F"/>
            </graphic>
        </Button>
        <Button fx:id="openFolderBtn" styleClass="button-secondary" onAction="#handleOpenFolder">
            <graphic>
                <FontIcon iconLiteral="mdal-folder_open" iconSize="18" iconColor="#49454F"/>
            </graphic>
        </Button>
        <Button fx:id="closeBtn" styleClass="button-secondary" onAction="#handleClose">
            <graphic>
                <FontIcon iconLiteral="mdal-close" iconSize="18" iconColor="#49454F"/>
            </graphic>
        </Button>
    </HBox>
</HBox>
