<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kalman03.svt.desktop.controller.LoginController"
           styleClass="login-background"
           alignment="CENTER">

    <!-- 登录卡片 - 垂直居中，自适应高度 -->
    <VBox fx:id="loginCard" styleClass="login-card" alignment="TOP_CENTER" spacing="20" maxWidth="440">
        <padding>
            <Insets top="36" right="40" bottom="36" left="40"/>
        </padding>

        <!-- Logo 和标题 -->
        <VBox alignment="CENTER" spacing="8">
            <ImageView fitWidth="56" fitHeight="56" preserveRatio="true">
                <Image url="@/icons/logo.png"/>
            </ImageView>
            <Label fx:id="titleLabel" text="Video Downloader" styleClass="login-title"/>
            <Label fx:id="subtitleLabel" text="Sign in to continue" styleClass="login-subtitle"/>
        </VBox>

        <!-- 授权登录区域 -->
        <VBox spacing="14" alignment="CENTER">
            <!-- 授权登录按钮（只设计一个按钮） -->
            <Button fx:id="submitBtn" text="Authorize Login" styleClass="button-primary, login-submit-btn"
                    onAction="#handleSubmit" prefWidth="320"/>

            <!-- 错误提示 -->
            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"
                   wrapText="true" maxWidth="Infinity"/>
        </VBox>

        <!-- 账号来源提示 -->
        <HBox alignment="CENTER" spacing="4">
            <Label fx:id="accountHintLabel" text="Don't have an account? Register at" styleClass="account-hint"/>
            <Hyperlink text="snapvideotools.com" styleClass="website-link" onAction="#handleSubmit"/>
        </HBox>

        <!-- 语言切换下拉列表 -->
        <HBox alignment="CENTER" spacing="8">
            <FontIcon iconLiteral="mdal-language" iconSize="16" iconColor="#6B7D77"/>
            <ComboBox fx:id="languageComboBox" styleClass="language-combo" onAction="#handleLanguageChange"/>
        </HBox>
    </VBox>
</StackPane>
